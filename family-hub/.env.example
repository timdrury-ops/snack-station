# Copy to .env and fill in what you use. Everything is optional except PORT/TZ.
PORT=3000
TZ=America/Chicago

# Dropbox (bulletin board + screensaver art) — see README "Dropbox"
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Optional: paste a refresh token here instead of using the Connect button in Settings
DROPBOX_REFRESH_TOKEN=

# Home Assistant (smart home + Alexa) — see README "Alexa & smart home"
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
