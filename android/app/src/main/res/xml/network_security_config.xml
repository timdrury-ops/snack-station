<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar feeds are https; plain http is permitted for LAN devices (cameras, Home Assistant). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
